{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=tradingbot.db"
  },
  "TradingBot": {
    "Mode": "Paper",
    "Safety": {
      "KillSwitch": false,
      "RefuseLiveIfNotAcknowledged": true,
      "LiveTradingAcknowledged": false
    },
    "RiskManagement": {
      "DailyLossLimitPercent": 3.0,
      "MaxDrawdownLimitPercent": 10.0
    },
    "Binance": {
      "ApiKey": "BINANCE_API_KEY",
      "ApiSecret": "BINANCE_API_SECRET",
      "EnableLiveOrders": false,
      "UseTestnet": true
    },
    "MaxOpenPositions": 10,
    "DefaultStopLossPercent": 2.0,
    "DefaultTakeProfitPercent": 5.0,
    "RiskPerTradePercent": 1.0,
    "UpdateIntervalMs": 5000,
    "MaxPositionSize": 1000
  },
  "Admin": {
    "Username": "admin",
    "PasswordHash": ""
  },
  "AllowedHosts": "*"
}