@model TradingBot.Models.BacktestResult
@{
    ViewData["Title"] = "Backtest Results";
}

<div class="grid">
    <div class="p p-kpi">
        <div class="kpis">
            <div class="k">
                <span>Total Return</span>
                <b class="@(Model.TotalReturnPercent >= 0 ? "up" : "dn")">@Model.TotalReturnPercent.ToString("F2")%</b>
            </div>
            <div class="k">
                <span>Win Rate</span>
                <b>@Model.WinRate.ToString("F1")%</b>
                <i>@Model.WinningTrades W / @Model.LosingTrades L</i>
            </div>
            <div class="k">
                <span>Max Drawdown</span>
                <b class="dn">@Model.MaxDrawdownPercent.ToString("F2")%</b>
            </div>
            <div class="k">
                <span>Sharpe Ratio</span>
                <b>@Model.SharpeRatio</b>
            </div>
            <div class="k">
                <span>Total Trades</span>
                <b>@Model.TotalTrades</b>
            </div>
        </div>
    </div>

    <div class="p p-pos">
        <header><h3>Trade Statistics</h3></header>
        <div class="bd">
            <table>
                <tr><th>Metric</th><th>Value</th></tr>
                <tr><td>Initial Capital</td><td>$@Model.InitialCapital.ToString("N2")</td></tr>
                <tr><td>Final Capital</td><td>$@Model.FinalCapital.ToString("N2")</td></tr>
                <tr><td>Largest Win</td><td class="up">$@Model.LargestWin.ToString("N2")</td></tr>
                <tr><td>Largest Loss</td><td class="dn">$@Model.LargestLoss.ToString("N2")</td></tr>
            </table>
            <div style="margin-top: 20px;">
                <a asp-action="Index" class="go" style="text-decoration:none; display:inline-block; text-align:center; width:auto; padding: 10px 20px;">← Back to Backtester</a>
            </div>
        </div>
    </div>
</div>