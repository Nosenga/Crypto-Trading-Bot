<!-- Views/Backtest/Index.cshtml -->
@model TradingBot.ViewModels.BacktestViewModel
@using TradingBot.Models
@{
    ViewData["Title"] = "Backtest";
}

<div class="grid">
    <!-- Backtest Form -->
    <div class="p">
        <header>
            <h3>Run Backtest</h3>
        </header>
        <div class="bd">
            <form asp-action="Run" method="post">
                <label>Strategy</label>
                <select asp-for="StrategyId">
                    <option value="">Select strategy...</option>
                    @foreach (var s in Model.Strategies)
                    {
                        <option value="@s.Id">@s.Name (@s.Type — @s.Symbol)</option>
                    }
                </select>

                <div class="sum">
                    <dt>Start Date</dt>
                    <dd><input asp-for="StartDate" type="date" /></dd>
                    <dt>End Date</dt>
                    <dd><input asp-for="EndDate" type="date" /></dd>
                    <dt>Initial Capital ($)</dt>
                    <dd><input asp-for="InitialCapital" type="number" /></dd>
                </div>

                <button type="submit" class="go">
                    <i class="fas fa-flask"></i> Run Backtest
                </button>
            </form>
        </div>
    </div>

    <!-- Previous Tests -->
    <div class="p p-pos">
        <header>
            <h3>Previous Tests</h3>
            <span class="mu">@Model.History.Count</span>
        </header>
        <div class="bd">
            @if (Model.History.Any())
            {
                @foreach (var bt in Model.History.Take(10))
                {
                    <a asp-action="Results" route-id="@bt.Id" class="p">
                        <div>
                            <strong>@bt.StrategyName</strong>
                            <br />
                            <small class="mu">@bt.StartDate.ToString("MM/dd") — @bt.EndDate.ToString("MM/dd")</small>
                        </div>
                        <span class="@(bt.TotalReturnPercent >= 0 ? "up" : "dn") fw-bold">@bt.TotalReturnPercent.ToString("F2")%</span>
                    </a>
                }
            }
            else
            {
                <div class="mu text-center py-3">No backtest history</div>
            }
        </div>
    </div>
</div>