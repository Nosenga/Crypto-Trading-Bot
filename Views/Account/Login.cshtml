<!-- Views/Account/Login.cshtml -->
@model TradingBot.ViewModels.LoginViewModel
@using TradingBot.Models
@{
    ViewData["Title"] = "Login - TradingBot Pro";
}

<div id="login" class="ov">
    <div class="box">
        <h2 style="font-weight: 700; letter-spacing:.09em; text-transform:uppercase; color:var(--mu); font-size:20px; margin-bottom:24px">Login</h2>
        
        <form method="post" asp-controller="Account" asp-action="Login">
            <div style="margin-bottom:16px">
                <label style="display:block;font-size:11px;color:var(--mu);text-transform:uppercase;letter-spacing:.06em;margin-bottom:9px">Username</label>
                <input style="background:transparent;border:1px solid var(--bd);color:var(--tx);padding:7px 9px;font:13px var(--mono)" asp-for="Username" required />
            </div>
            
            <div style="margin-bottom:16px">
                <label style="display:block;font-size:11px;color:var(--mu);text-transform:uppercase;letter-spacing:.06em;margin-bottom:9px">Password</label>
                <input style="background:transparent;border:1px solid var(--bd);color:var(--tx);padding:7px 9px;font:13px var(--mono)" asp-for="Password" type="password" required />
            </div>
            
            <button type="submit" style="width:100%;padding:9px;background:var(--dn);color:#fff;border:0;font:700 12px var(--mono);letter-spacing:.1em;cursor;margin-top:14px">
                <i class="fas fa-sign-in me-2"></i> Login
            </button>
        </form>
    </div>
</div>