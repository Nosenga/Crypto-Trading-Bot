<!-- Views/Trading/Index.cshtml -->
@model TradingBot.ViewModels.TradeViewModel
@using TradingBot.Models
@{
    ViewData["Title"] = "Trading";
    var portfolio = ViewBag.Portfolio as TradingBot.Models.Portfolio;
    var openTrades = ViewBag.OpenTrades as List<TradingBot.Models.Trade>;
    var tradeHistory = ViewBag.TradeHistory as List<TradingBot.Models.Trade>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 style="font-weight: 700;">⚡ Execute Trades</h2>
        <p class="text-muted mb-0">Manual and automated trading</p>
    </div>
    <div class="d-flex gap-2">
        <div class="stat-card px-3 py-2">
            <small class="text-muted">Balance</small>
            <div class="fw-bold fs-5">
                $@Model.AccountBalance.ToString("N2")
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- Order Form -->
    <div class="col-lg-4">
        <div class="card-trading">
            <div class="card-header">
                <i class="fas fa-paper-plane"></i> Place Order
            </div>
            <form asp-action="Execute" method="post">
                <div class="mb-3">
                    <label class="form-label text-muted">Symbol</label>
                    <select asp-for="Symbol" class="form-select">
                        @foreach (var symbol in Model.AvailableSymbols)
                        {
                            <option value="@symbol">@symbol</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted">Order Type</label>
                    <div class="btn-group w-100" role="group">
                        <input type="radio" class="btn-check" name="Type"
                               id="buyRadio" value="Buy" checked />
                        <label class="btn btn-buy" for="buyRadio">
                            <i class="fas fa-arrow-up"></i> BUY
                        </label>

                        <input type="radio" class="btn-check" name="Type"
                               id="sellRadio" value="Sell" />
                        <label class="btn btn-sell" for="sellRadio">
                            <i class="fas fa-arrow-down"></i> SELL
                        </label>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted">
                        Current Price (USD)
                    </label>
                    <div class="input-group">
                        <span class="input-group-text"
                              style="background:var(--bg-secondary);
                                     border-color:var(--border-color);
                                     color:var(--text-secondary);">
                            $
                        </span>
                        <input type="text" id="currentPrice"
                               class="form-control" readonly
                               value="Loading..." />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted">
                        Quantity (asset units)
                    </label>
                    <input asp-for="Quantity" type="number"
                           class="form-control"
                           step="0.00000001" min="0.00000001"
                           placeholder="0.001" />
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label text-muted">
                            Stop Loss ($)
                        </label>
                        <input asp-for="StopLoss" type="number"
                               class="form-control"
                               step="0.01" placeholder="Optional" />
                    </div>
                    <div class="col-6">
                        <label class="form-label text-muted">
                            Take Profit ($)
                        </label>
                        <input asp-for="TakeProfit" type="number"
                               class="form-control"
                               step="0.01" placeholder="Optional" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted">
                        Strategy (optional)
                    </label>
                    <input asp-for="Strategy" type="text"
                           class="form-control"
                           placeholder="e.g., MA Crossover" />
                </div>

                <button type="submit"
                        class="btn btn-buy w-100 py-2 fs-5">
                    <i class="fas fa-bolt"></i> Execute Trade
                </button>
            </form>
        </div>

        <!-- Quick Calculator -->
        <div class="card-trading">
            <div class="card-header">
                <i class="fas fa-calculator"></i> Position Sizer
            </div>
            <div class="mb-2">
                <label class="form-label text-muted small">
                    Account Risk (%)
                </label>
                <input type="number" id="riskPercent"
                       class="form-control" value="1" step="0.1" />
            </div>
            <div class="mb-2">
                <label class="form-label text-muted small">
                    Stop Loss Distance (%)
                </label>
                <input type="number" id="slPercent"
                       class="form-control" value="2" step="0.1" />
            </div>
            <div class="p-2 rounded text-center"
                 style="background:var(--bg-secondary);">
                <small class="text-muted">Suggested Position Size</small>
                <div class="fw-bold fs-5" id="positionSize">$0.00</div>
            </div>
        </div>
    </div>

    <!-- Open Positions -->
    <div class="col-lg-8">
        <div class="card-trading">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>
                    <i class="fas fa-briefcase"></i>
                    Open Positions
                </span>
                <span class="badge bg-dark">@(openTrades?.Count ?? 0)</span>
            </div>
            <div class="table-responsive">
                <table class="table table-trading table-sm">
                    <thead>
                        <tr>
                            <th>Symbol</th>
                            <th>Type</th>
                            <th>Entry Price</th>
                            <th>Quantity</th>
                            <th>Value</th>
                            <th>S/L</th>
                            <th>T/P</th>
                            <th>Strategy</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (openTrades != null && openTrades.Any())
                        {
                            @foreach (var trade in openTrades)
                            {
                                <tr>
                                    <td class="fw-bold">@trade.Symbol</td>
                                    <td>
                                        <span class="badge-@(trade.Type ==
                                            TradeType.Buy ? "buy" : "sell")">
                                            @trade.Type
                                        </span>
                                    </td>
                                    <td>$@trade.EntryPrice.ToString("N2")</td>
                                    <td>@trade.Quantity.ToString("N4")</td>
                                    <td>$@trade.TotalValue?.ToString("N2")</td>
                                    <td>
                                        @(trade.StopLoss.HasValue
                                            ? "$" + trade.StopLoss.Value.ToString("N2")
                                            : "—")
                                    </td>
                                    <td>
                                        @(trade.TakeProfit.HasValue
                                            ? "$" + trade.TakeProfit.Value.ToString("N2")
                                            : "—")
                                    </td>
                                    <td>
                                        <small>@(trade.Strategy ?? "Manual")</small>
                                    </td>
                                    <td>
                                        <form asp-action="CloseTrade" method="post"
                                              style="display:inline;">
                                            <input type="hidden" name="id"
                                                   value="@trade.Id" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-times"></i> Close
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">
                                    No open positions
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Trade History -->
        <div class="card-trading">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fas fa-history"></i> Trade History</span>
                <span class="text-muted small">Last 20 trades</span>
            </div>
            <div class="table-responsive">
                <table class="table table-trading table-sm">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Symbol</th>
                            <th>Type</th>
                            <th>Entry</th>
                            <th>Exit</th>
                            <th>P&L</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (tradeHistory != null)
                        {
                            @foreach (var trade in tradeHistory.Take(20))
                            {
                                <tr>
                                    <td>
                                        <small>
                                            @trade.CreatedAt.ToString("MM/dd HH:mm")
                                        </small>
                                    </td>
                                    <td class="fw-bold">@trade.Symbol</td>
                                    <td>
                                        <span class="badge-@(trade.Type ==
                                            TradeType.Buy ? "buy" : "sell")">
                                            @trade.Type
                                        </span>
                                    </td>
                                    <td>$@trade.EntryPrice.ToString("N2")</td>
                                    <td>
                                        @(trade.ExitPrice.HasValue
                                            ? "$" + trade.ExitPrice.Value.ToString("N2")
                                            : "—")
                                    </td>
                                    <td class="@(trade.ProfitLoss >= 0
                                        ? "positive" : "negative")">
                                        @(trade.ProfitLoss.HasValue
                                            ? "$" + trade.ProfitLoss.Value.ToString("N2")
                                            : "—")
                                    </td>
                                    <td><small>@trade.Status</small></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/trading.js"></script>
}