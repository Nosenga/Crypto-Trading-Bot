<!-- Views/Trading/Index.cshtml -->
@model TradingBot.ViewModels.TradeViewModel
@using TradingBot.Models
@{
    ViewData["Title"] = "Trading";
    var portfolio = ViewBag.Portfolio as TradingBot.Models.Portfolio;
    var openTrades = ViewBag.OpenTrades as List<TradingBot.Models.Trade>;
    var tradeHistory = ViewBag.TradeHistory as List<TradingBot.Models.Trade>;
}

<div class="grid">
    <div style="grid-column: 1 / -1; display:flex; justify-content:space-between; align-items:center; margin-bottom: 12px;">
        <div>
            <h3 style="font-size:14px; letter-spacing:.09em; text-transform:uppercase; color:var(--mu); font-weight:600;">
                <i class="fas fa-bolt"></i> Execute Trades
            </h3>
            <p style="font-size:11px; color:var(--mu); text-transform:uppercase; letter-spacing:.06em;">
                Manual and automated trading
            </p>
        </div>
        <div class="mini">
            <span>Balance</span>
            <b>$@Model.AccountBalance.ToString("N2")</b>
        </div>
    </div>

<!-- Order Form -->
    <div class="p p-tkt">
        <header>
            <h3>Place Order</h3>
        </header>
        <div class="bd">
            <form asp-action="Execute" method="post">
                <label>Symbol</label>
                    <select asp-for="Symbol">
                    @foreach (var symbol in Model.AvailableSymbols)
                    {
                        <option value="@symbol">@symbol</option>
                    }
                </select>

                <label>Order Type</label>
                    <div class="seg">
                    <input type="radio" class="btn-check" name="Type" id="buyRadio" value="Buy" checked />
                    <label for="buyRadio" class="on">
                        <i class="fas fa-arrow-up"></i> BUY
                    </label>
                    <input type="radio" class="btn-check" name="Type" id="sellRadio" value="Sell" />
                    <label for="sellRadio">
                        <i class="fas fa-arrow-down"></i> SELL
                    </label>
                </div>

                <label>Current Price (USD)</label>
                <input type="text" id="currentPrice" readonly value="Loading..." />

                <label>Quantity (asset units)</label>
                <input asp-for="Quantity" type="number"
                       step="0.00000001" min="0.00000001"
                       placeholder="0.001" />

                <div class="sum">
                    <dt>Stop Loss ($)</dt>
                    <dd><input asp-for="StopLoss" type="number"
                               step="0.01" placeholder="Optional" /></dd>
                    <dt>Take Profit ($)</dt>
                    <dd><input asp-for="TakeProfit" type="number"
                               step="0.01" placeholder="Optional" /></dd>
                </div>

                <label>Strategy (optional)</label>
                <input asp-for="Strategy" type="text"
                       placeholder="e.g., MA Crossover" />

                <button type="submit" class="go">
                    <i class="fas fa-bolt"></i> Execute Trade
                </button>
            </form>
        </div>
    </div>

    <!-- Position Sizer -->
    <div class="p">
        <header>
            <h3>Position Sizer</h3>
        </header>
        <div class="bd">
            <label>Account Risk (%)</label>
            <input type="number" id="riskPercent" value="1" step="0.1" />
            <label>Stop Loss Distance (%)</label>
            <input type="number" id="slPercent" value="2" step="0.1" />
            <div class="mini">
                <span>Suggested Position Size</span>
                <b id="positionSize">$0.00</b>
            </div>
        </div>
    </div>

    <!-- Open Positions -->
    <div class="p p-pos">
        <header>
            <h3>Open Positions</h3>
            <span class="mu">@(openTrades?.Count ?? 0)</span>
        </header>
        <div class="bd">
            <table>
                <thead>
                    <tr>
                        <th>Symbol</th>
                        <th>Type</th>
                        <th>Entry Price</th>
                        <th>Quantity</th>
                        <th>Value</th>
                        <th>S/L</th>
                        <th>T/P</th>
                        <th>Strategy</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                        @if (openTrades != null && openTrades.Any())
                        {
                            @foreach (var trade in openTrades)
                            {
                                <tr>
                                    <td class="fw-bold">@trade.Symbol</td>
                                    <td>@trade.Type</td>
                                    <td>$@trade.EntryPrice.ToString("N2")</td>
                                    <td>@trade.Quantity.ToString("N4")</td>
                                    <td>$@trade.TotalValue?.ToString("N2")</td>
                                    <td>
                                        @(trade.StopLoss.HasValue
                                            ? "$" + trade.StopLoss.Value.ToString("N2")
                                            : "—")
                                    </td>
                                    <td>
                                        @(trade.TakeProfit.HasValue
                                            ? "$" + trade.TakeProfit.Value.ToString("N2")
                                            : "—")
                                    </td>
                                    <td>
                                        <small>@(trade.Strategy ?? "Manual")</small>
                                    </td>
                                    <td>
                                        <form asp-action="CloseTrade" method="post"
                                              style="display:inline;">
                                            <input type="hidden" name="id"
                                                   value="@trade.Id" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-times"></i> Close
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">
                                    No open positions
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Trade History -->
    <div class="p">
        <header>
            <h3>Trade History</h3>
            <span class="mu">Last 20 trades</span>
        </header>
        <div class="bd">
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Symbol</th>
                        <th>Type</th>
                        <th>Entry</th>
                        <th>Exit</th>
                        <th>P&L</th>
                        <th>Status</th>
                    </tr>
                    </thead>
                    <tbody>
                        @if (tradeHistory != null)
                        {
                            @foreach (var trade in tradeHistory.Take(20))
                            {
                                <tr>
                                    <td><small class="mu">
                                        @trade.CreatedAt.ToString("MM/dd HH:mm")
                                    </small></td>
                                    <td class="fw-bold">@trade.Symbol</td>
                                    <td>@trade.Type</td>
                                    <td>$@trade.EntryPrice.ToString("N2")</td>
                                    <td>
                                        @(trade.ExitPrice.HasValue
                                            ? "$" + trade.ExitPrice.Value.ToString("N2")
                                            : "—")
                                    </td>
                                    <td class="@(trade.ProfitLoss >= 0 ? "up" : "dn")">
                                        @(trade.ProfitLoss.HasValue
                                            ? "$" + trade.ProfitLoss.Value.ToString("N2")
                                            : "—")
                                    </td>
                                    <td><small class="mu">@trade.Status</small></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/trading.js"></script>
}