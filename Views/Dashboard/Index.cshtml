<!-- Views/Dashboard/Index.cshtml -->
@model TradingBot.ViewModels.DashboardViewModel
@using TradingBot.Models
@{
    ViewData["Title"] = "Dashboard";
}

<div class="grid">
    <!-- KPI Row -->
    <div class="kpis">
        <div class="k">
            <span>Total Equity</span>
            <b>$@Model.TotalEquity.ToString("N2")</b>
            <i class="@(Model.ReturnPercent >= 0 ? "up" : "dn")">
                @Model.ReturnPercent.ToString("F2")% all time
            </i>
        </div>
        <div class="k">
            <span>Unrealized P&L</span>
            <b class="@(Model.UnrealizedPnL >= 0 ? "up" : "dn")">
                $@Model.UnrealizedPnL.ToString("N2")
            </b>
            <i>@Model.OpenPositions open positions</i>
        </div>
        <div class="k">
            <span>Win Rate</span>
            <b class="mu">@Model.WinRate.ToString("F1")%</b>
            <i>@Model.TotalTrades total trades</i>
        </div>
        <div class="k">
            <span>Active Strategies</span>
            <b class="mu">@Model.ActiveStrategies</b>
            <i>Running automatically</i>
        </div>
    </div>

    <!-- Equity Chart -->
    <div class="p p-chart">
        <header>
            <h3>Portfolio Performance</h3>
            <div>
                <button class="x2" onclick="updateChart('1W')">1W</button>
                <button class="x2" onclick="updateChart('1M')">1M</button>
                <button class="x2 on" onclick="updateChart('ALL')">ALL</button>
            </div>
        </header>
        <div class="bd">
            <div class="chart">
                <canvas id="equityChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Market Prices -->
    <div class="p p-sig">
        <header>
            <h3>Live Markets</h3>
        </header>
        <div class="bd">
            @foreach (var price in Model.LivePrices)
            {
                <div style="display:flex;justify-content:space-between;padding:7px 0;border-top:1px solid var(--bd);font-size:13px;">
                    <div>
                        <strong>@price.Key.Replace("USDT", "")</strong>
                        <br />
                        <small class="mu">/USDT</small>
                    </div>
                    <div class="text-end">
                        <span class="price-live fw-bold" data-symbol="@price.Key">
                            $@price.Value.ToString("N2")
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>

<!-- Active Signals -->
    <div class="p p-strat">
        <header>
            <h3>Active Signals</h3>
            <span class="mu">@Model.ActiveSignals.Count</span>
        </header>
            @if (Model.ActiveSignals.Any())
            {
                @foreach (var signal in Model.ActiveSignals.Take(8))
                {
                    <div style="display:flex;justify-content:space-between;align-items:center;padding:7px 0;border-top:1px solid var(--bd);font-size:13px;">
                        <div>
                            <strong>@signal.Symbol</strong>
                            <br />
                            <small class="mu">@signal.Source — @signal.Reason</small>
                        </div>
                        <div class="text-end">
                            <div style="min-width: 80px;">
                                <small class="text-muted">Confidence</small>
                                <div class="bar">
                                    <i style="height:100%;background:@(signal.Confidence > 70 ? "var(--up)" : signal.Confidence > 50 ? "#f5c451" : "var(--dn)");width:@signal.Confidence%;"></i>
                                         </div>
                                <small>@signal.Confidence.ToString("F0")%</small>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="mu text-center py-3">No active signals</p>
            }
        </div>
    </div>

    <!-- Market News -->
    <div class="p p-sig">
        <header>
            <h3>Market News</h3>
        </header>
        <div class="bd">
            @if (Model.News != null && Model.News.Any())
            {
                <ul class="feed">
                    @foreach (var item in Model.News)
                    {
                        <li>
                            <em class="@(item.Score > 0 ? "positive" : item.Score < 0 ? "negative" : "neutral")">
                                @item.Headline
                            </em>
                            <small class="mu">@item.Source</small>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="mu text-center py-3">No news available</p>
            }
        </div>
    </div>

    <!-- Recent Trades -->
    <div class="p p-pos">
        <header>
            <h3>Recent Trades</h3>
            <span class="mu">Last 10 trades</span>
        </header>
        <div class="bd">
            <table>
                <thead>
                    <tr>
                        <th>Symbol</th>
                        <th>Type</th>
                        <th>Entry</th>
                        <th>Exit</th>
                        <th>P&L</th>
                        <th>Status</th>
                    </tr>
                    </thead>
                    <tbody>
                        @foreach (var trade in Model.RecentTrades.Take(10))
                        {
                            <tr>
                            <td class="fw-bold">@trade.Symbol</td>
                            <td>@trade.Type</td>
                            <td>$@trade.EntryPrice.ToString("N2")</td>
                            <td>
                                @(trade.ExitPrice.HasValue
                                    ? "$" + trade.ExitPrice.Value.ToString("N2")
                                    : "—")
                            </td>
                            <td class="@(trade.ProfitLoss >= 0 ? "up" : "dn")">
                                @(trade.ProfitLoss.HasValue
                                    ? "$" + trade.ProfitLoss.Value.ToString("N2")
                                    : "—")
                            </td>
                            <td><small class="mu">@trade.Status</small></td>
                    </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js"></script>
}