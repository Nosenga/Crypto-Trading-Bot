<!-- Views/Strategy/Index.cshtml -->
@model List<TradingBot.Models.Strategy>
@using TradingBot.Models
@{
    ViewData["Title"] = "Strategies";
}

<div class="grid">
    <!-- Actions -->
    <div style="grid-column: 1 / -1; margin-bottom: 16px;">
        <div style="display:flex;justify-content:space-between;align-items:center">
            <div>
                <h3 style="font-size:14px; letter-spacing:.09em; text-transform:uppercase; color:var(--mu); font-weight:600">
                    ♟️ Trading Strategies
                </h3>
                <p style="font-size:11px; color:var(--mu); text-transform:uppercase; letter-spacing:.06em">
                    Manage automated strategies
                </p>
            </div>
            <a asp-action="Create" class="x2">
                <i class="fas fa-plus"></i> New Strategy
            </a>
        </div>
    </div>

    <div class="row g-3">
        @foreach (var strategy in Model)
        {
            <div class="col-lg-4 col-md-6">
                <div class="p">
                    <header>
                        <h3>@strategy.Name</h3>
                    </header>
                    <div class="bd">
                        <div class="sum">
                            <dt>Type</dt>
                            <dd>@strategy.Type</dd>
                            <dt>Symbol</dt>
                            <dd>@strategy.Symbol</dd>
                            <dt>S/L</dt>
                            <dd>@strategy.StopLossPercent%</dd>
                            <dt>T/P</dt>
                            <dd>@strategy.TakeProfitPercent%</dd>
                            <dt>Win Rate</dt>
                            <dd>
                                <span class="@(strategy.WinRate >= 50 ? "tag" : "")">
                                    <b>@strategy.WinRate.ToString("F1")%</b>
                                </span>
                            </dd>
                            <dt>Trades</dt>
                            <dd>@strategy.TotalTrades</dd>
                            <dt>P&L</dt>
                            <dd class="@(strategy.TotalProfitLoss >= 0 ? "up" : "dn")">
                                $@strategy.TotalProfitLoss.ToString("N2")
                            </dd>
                        </div>
                        <div class="d-flex gap-2 mt-3">
                            <form asp-action="ToggleStatus" method="post">
                                <input type="hidden" name="id" value="@strategy.Id" />
                                <button type="submit" class="@(strategy.Status == TradingBot.Models.StrategyStatus.Active ? "x2" : "")">
                                    <i class="fas fa-pause"></i> @(strategy.Status == TradingBot.Models.StrategyStatus.Active ? "Pause" : "Activate")
                                </button>
                            </form>
                            <a asp-action="Details" asp-route-id="@strategy.Id" class="x2">
                                <i class="fas fa-chart-bar"></i>
                            </a>
                            <form asp-action="Delete" method="post">
                                <input type="hidden" name="id" value="@strategy.Id" />
                                <button type="submit" class="x2" onclick="return confirm('Delete strategy?)">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>