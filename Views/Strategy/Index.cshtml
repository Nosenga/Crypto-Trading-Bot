<!-- Views/Strategy/Index.cshtml -->
@model List<TradingBot.Models.Strategy>
@{
    ViewData["Title"] = "Strategies";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 style="font-weight: 700;">♟️ Trading Strategies</h2>
        <p class="text-muted mb-0">Manage automated strategies</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> New Strategy
    </a>
</div>

<div class="row g-3">
    @foreach (var strategy in Model)
    {
        <div class="col-lg-4 col-md-6">
            <div class="card-trading h-100">
                <div class="card-header">
                    <span>@strategy.Name</span>
                    <span class="badge @(strategy.Status ==
                        TradingBot.Models.StrategyStatus.Active
                            ? "bg-success" : "bg-secondary")">
                        @strategy.Status
                    </span>
                </div>

                <p class="text-muted small mb-3">
                    @(strategy.Description ?? "No description")
                </p>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <div class="p-2 rounded text-center"
                             style="background:var(--bg-secondary);">
                            <small class="text-muted">Type</small>
                            <div class="fw-bold small">@strategy.Type</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 rounded text-center"
                             style="background:var(--bg-secondary);">
                            <small class="text-muted">Symbol</small>
                            <div class="fw-bold small">@strategy.Symbol</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 rounded text-center"
                             style="background:var(--bg-secondary);">
                            <small class="text-muted">S/L</small>
                            <div class="fw-bold small">
                                @strategy.StopLossPercent%
                            </div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 rounded text-center"
                             style="background:var(--bg-secondary);">
                            <small class="text-muted">T/P</small>
                            <div class="fw-bold small">
                                @strategy.TakeProfitPercent%
                            </div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 rounded text-center"
                             style="background:var(--bg-secondary);">
                            <small class="text-muted">Win</small>
                            <div class="fw-bold small positive">
                                @strategy.WinRate.ToString("F1")%
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between small">
                        <span class="text-muted">
                            Trades: @strategy.TotalTrades
                        </span>
                        <span class="@(strategy.TotalProfitLoss >= 0
                            ? "positive" : "negative")">
                            P&L: $@strategy.TotalProfitLoss.ToString("N2")
                        </span>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <form asp-action="ToggleStatus" method="post"
                          class="flex-grow-1">
                        <input type="hidden" name="id" value="@strategy.Id" />
                        <button type="submit"
                                class="btn btn-sm btn-outline-secondary w-100">
                            @(strategy.Status ==
                                TradingBot.Models.StrategyStatus.Active
                                    ? "Pause" : "Activate")
                        </button>
                    </form>
                    <a asp-action="Details" asp-route-id="@strategy.Id"
                       class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-chart-bar"></i>
                    </a>
                    <form asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@strategy.Id" />
                        <button type="submit"
                                class="btn btn-sm btn-outline-danger"
                                onclick="return confirm('Delete strategy?')">
                            <i class="fas fa-trash"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>