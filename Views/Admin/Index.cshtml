@model TradingBot.ViewModels.AdminViewModel

@{
    ViewData["Title"] = "Admin - Kill Switch Controls";
}

<div class="grid">
    <!-- Safety Status -->
    <div class="p p-risk">
        <header>
            <h3>Safety Status</h3>
            <span class="@(Model.IsKillSwitchActive ? "dn" : "up")">
                @(Model.IsKillSwitchActive ? "KILL SWITCH ACTIVE" : "SYSTEM NORMAL")
            </span>
        </header>
        <div class="bd">
            <div class="sum">
                <dt>Trading Mode</dt>
                <dd class="fw-bold">@(Model.IsArmed ? "ARMED" : "DISARMED — SHADOW MODE")</dd>
                <dt>Kill Switch</dt>
                <dd class="@(Model.IsKillSwitchActive ? "dn" : "up")">
                    @(Model.IsKillSwitchActive ? "ACTIVE" : "INACTIVE")
                </dd>
                <dt>High Water Mark</dt>
                <dd>$@Model.HighWaterMark.ToString("N2")</dd>
                <dt>Daily Loss Limit (@Model.DailyLossLimitPercent.ToString("N1")%)</dt>
                <dd class="@(Model.IsDailyLossLimitBreached ? "dn" : "up")">
                    <strong>@(Model.IsDailyLossLimitBreached ? "HIT" : "WITHIN LIMIT")</strong>
                </dd>
                <dt>Today's Start Balance</dt>
                <dd>$@Model.StartOfDayBalance.ToString("N2")</dd>
                <dt>Current Balance</dt>
                <dd>$@Model.CurrentBalance.ToString("N2")</dd>
                <dt>Daily Loss</dt>
                <dd>@Model.DailyLossPercent.ToString("N2")%</dd>
                @if (Model.KillSwitchAt.HasValue)
                {
                    <dt>Activated</dt>
                    <dd>@Model.KillSwitchAt.Value.ToString("yyyy-MM-dd HH:mm:ss UTC")</dd>
                }
                @if (!string.IsNullOrEmpty(Model.KillSwitchReason))
                {
                    <dt>Reason</dt>
                    <dd>@Model.KillSwitchReason</dd>
                }
            </div>
        </div>
    </div>

    <h3>Controls</h3>

    <form method="post" asp-action="Arm">
        <button type="submit" class="btn btn-success">
            <i class="fas fa-play"></i> Arm Trading
        </button>
    </form>

    <form method="post" asp-action="Disarm">
        <button type="submit" class="btn btn-secondary">
            <i class="fas fa-pause"></i> Disarm Trading
        </button>
    </form>

    <form method="post" asp-action="Activate">
        <button type="submit" name="reason" value="Manual admin activate" class="btn btn-danger">
            <i class="fas fa-exclamation-triangle"></i> Activate Kill Switch
        </button>
    </form>

    <form method="post" asp-action="Deactivate">
        <button type="submit" class="btn btn-success">
            <i class="fas fa-check-circle"></i> Deactivate Kill Switch
        </button>
    </form>

    <hr />

    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-link">
        <i class="fas fa-chart-line"></i> Return to Dashboard
    </a>
</div>