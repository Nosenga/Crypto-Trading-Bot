@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var configuredMode = Configuration["TradingBot:Mode"] ?? "Paper";
    var mode = configuredMode.Equals("Live", StringComparison.OrdinalIgnoreCase)
        ? "live"
        : configuredMode.Equals("Testnet", StringComparison.OrdinalIgnoreCase)
            ? "testnet"
            : "paper";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TradingBot</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600;700&family=Orbitron:wght@500;700&family=Rajdhani:wght@500;600;700&family=Share+Tech+Mono&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap"
          rel="stylesheet" />
    <link rel="stylesheet" href="~/css/obsidian.css" asp-append-version="true" />
</head>
<body data-mode="@mode">
    <div id="strip">
        <span id="modeBtn" class="mode" role="status"
              title="Trading mode is configured at startup">
            <i aria-hidden="true"></i>
            <b>@mode.ToUpperInvariant()</b>
        </span>
        <span id="mtxt">Configured at startup</span>
        <span class="sp"></span>
        <span>Live data is page-specific</span>
        <span>Background chart is simulated</span>
    </div>

    <canvas id="bg2" aria-hidden="true"></canvas>
    <canvas id="bg" aria-hidden="true"></canvas>
    <canvas id="mk" aria-hidden="true"></canvas>
    <div id="flash" aria-hidden="true"></div>
    <div id="src" aria-live="polite">Decorative background</div>

    <nav class="top" data-nav aria-label="Main navigation">
        <b>tradingbot</b>
        <a asp-controller="Dashboard" asp-action="Index"
           class="@(currentController == "Dashboard" ? "on" : null)">Overview</a>
        <a asp-controller="Strategy" asp-action="Index"
           class="@(currentController == "Strategy" ? "on" : null)">Strategies</a>
        <a asp-controller="Backtest" asp-action="Index"
           class="@(currentController == "Backtest" ? "on" : null)">Backtests</a>
        <a asp-controller="Trading" asp-action="Index"
           class="@(currentController == "Trading" ? "on" : null)">Trading &amp; History</a>
        <a asp-controller="Admin" asp-action="Index"
           class="@(currentController == "Admin" ? "on" : null)">Admin</a>
        <span class="sp"></span>
        <button class="kbd" id="kbd" type="button" aria-label="Open command palette">Ctrl K</button>
        <button class="bgt" type="button" title="Toggle decorative background"
                aria-label="Toggle decorative background">&#9681;</button>
        <a class="new" asp-controller="Trading" asp-action="Index">New order</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post" asp-controller="Account" asp-action="Logout">
                <button class="kbd" type="submit">Sign out</button>
            </form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login">Sign in</a>
        }
    </nav>

    <div class="wrap">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="status">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"
                        aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"
                        aria-label="Close"></button>
            </div>
        }
        <main>
            @RenderBody()
        </main>
    </div>

    <div id="pal" class="ov" hidden>
        <div class="box">
            <input id="pin" placeholder="Find a page…" autocomplete="off"
                   aria-label="Filter navigation pages" />
            <ul id="pl">
                <li><a asp-controller="Dashboard" asp-action="Index">Overview</a></li>
                <li><a asp-controller="Strategy" asp-action="Index">Strategies</a></li>
                <li><a asp-controller="Backtest" asp-action="Index">Backtests</a></li>
                <li><a asp-controller="Trading" asp-action="Index">Trading &amp; History</a></li>
                <li><a asp-controller="Admin" asp-action="Index">Admin</a></li>
            </ul>
            <small>Ctrl K open &middot; Esc close</small>
        </div>
    </div>
    <div id="toast" role="status" aria-live="polite"></div>

    <script>
        // Display TempData messages as toast notifications
        document.addEventListener('DOMContentLoaded', function() {
            var toastEl = document.getElementById('toast');
            var success = '@TempData["Success"]';
            var error = '@TempData["Error"]';

            if (success) {
                toastEl.textContent = success;
                toastEl.className = 'toast success';
                setTimeout(function() { toastEl.className = toastEl.className.replace(' success', ''); }, 5000);
            }
            else if (error) {
                toastEl.textContent = error;
                toastEl.className = 'toast error';
                setTimeout(function() { toastEl.className = toastEl.className.replace(' error', ''); }, 5000);
            }
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/obsidian.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
